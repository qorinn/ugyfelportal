# Supabase — a service_role kulcs SOHA nem kaphat NEXT_PUBLIC_ előtagot.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# A paladi-web /api/track proxy ezzel hitelesíti magát a /api/event felé.
INGEST_SECRET=

# A dashboard jelszavas kapuja (proxy.ts).
DASHBOARD_PASSWORD=

# A CMS „Publikálás” gombja ezt a Netlify build hookot hívja. Titkos érték,
# ezért ugyanúgy ne kapjon NEXT_PUBLIC_ előtagot.
NETLIFY_BUILD_HOOK_URL=
